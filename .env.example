# Example configuration; never commit real credentials.
# Docker Compose reads .env automatically.
# Direct Flask startup does not load .env automatically.

# Copy to .env and adjust:  cp .env.example .env
# .env is listed in .gitignore and must never be committed.

# Optional for Flask on the host with a locally reachable Postgres database.
# Without DATABASE_URL, Flask uses in-memory storage.
# DATABASE_URL=postgresql://expenses:changeme@localhost:5432/expenses

POSTGRES_PASSWORD=changeme
APP_VERSION=1.0.0-local
LOG_LEVEL=INFO
PORT=8000
GUNICORN_WORKERS=1
